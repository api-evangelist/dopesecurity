  "info": {
    "_postman_id": "643345c7-5264-448d-8964-c1b1086f9899",
    "name": "Flightdeck - dope.security - Public API specification Authorization API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Flightdeck API by dope.security. Manage policies, custom categories, URL/application bypass, SSL inspection, and endpoint status for the dope.swg Secure Web Gateway. Authentication uses the OAuth 2.0 Client Credentials flow; the returned bearer token is required on all non-token calls.\n\nContact Support:\n Name: dope.security Support\n Email: support@dope.security",
      "type": "text/plain"
    }
