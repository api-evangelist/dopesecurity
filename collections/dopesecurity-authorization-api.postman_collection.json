          "name": "oauth",
          "item": [
            {
              "name": "token",
              "item": [
                {
                  "name": "Generate Flightdeck API access token",
                  "id": "cb1b74fc-bbb0-462f-b7c3-8817b7f79cf2",
                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/json"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/partner/oauth/token",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "partner",
                        "oauth",
                        "token"
                      ]
                    },
                    "description": "Use this API to generate an access token for use with the Flightdeck API. A valid access token returned from\nthis API is required in all other Flightdeck API calls.\n\nToken generation is based on the OAuth 2.0 Client Credentials Flow. The returned token is used within the\nHTTP Authorization header as follows:\n\n`Authorization: Bearer `\n\nNote:\n- The required `client_id` and `client_secret` are created by an admin via the dope console.\n- Returned access tokens are valid for a limited time period. Clients must check the `expires_in` value in\nthe response to generate a new access token before the current one expires.\n- The OAuth scopes parameter is not supported and if provided will be ignored. The scopes returned in the access\ntoken are set directly by the authorization server."
                  },
                  "response": [
                    {
                      "id": "4a304ca9-6f5a-4aa9-bc80-2039dd228c55",
                      "name": "OK",
                      "originalRequest": {
                        "method": "POST",
                        "header": [
