{
  "info": {
    "_postman_id": "fa853f5a-bdeb-488f-9a9f-bd7059d20b3d",
    "name": "Flightdeck - dope.security - Public API specification\u2026",
    "description": "The Flightdeck API by dope.security. Manage policies, custom categories, URL/application bypass, SSL inspection, and endpoint status for the dope.swg Secure Web Gateway. Authentication uses the OAuth 2.0 Client Credentials flow; the returned bearer token is required on all non-token calls.\n\nContact Support:\n Name: dope.security Support\n Email: support@dope.security",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-10-22T02:05:58.000Z",
    "updatedAt": "2026-10-22T02:05:58.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-fa853f5a-bdeb-488f-9a9f-bd7059d20b3d"
  },
