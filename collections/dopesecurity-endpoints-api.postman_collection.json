{
  "item": [
    {
      "id": "0c9d2b67-7470-4608-8921-ec43e30cd66e",
      "name": "Endpoints",
      "description": {
        "content": "Everything about your endpoints",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "926c7122-1187-416b-bacd-980f3ebb4eaa",
          "name": "List and Search Endpoints",
          "request": {
            "name": "List and Search Endpoints",
            "description": {
              "content": "Use this API to get a list of all endpoints, or search for those matching a query parameter.\n\nNote:\n- To return a list of all endpoints do not include any additional parameter.\n- Only one of the optional parameters is allowed to be specified per request.\n- Results are returned in pages using cursor based pagination and ordered by the `lastSeen` property.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "endpoints",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "Broad search query across endpoints by device, user and email identities that contain this string (case-insensitive)"
                },
                {
                  "disabled": false,
                  "key": "emailId",
                  "value": "<string>",
                  "description": "Search by email ids that contain this string (case-insensitive)"
                },
                {
                  "disabled": false,
                  "key": "deviceName",
                  "value": "<string>",
                  "description": "Search by device names that contain this string (case-insensitive)"
                },
                {
                  "disabled": false,
                  "key": "userId",
                  "value": "<string>",
                  "description": "Search by user ids that contain this string (case-insensitive). `userId` for OIDC users is usually their email address."
                },
                {
                  "disabled": false,
                  "key": "osVersion",
                  "value": "<string>",
                  "description": "Filter by this exact device OS version string"
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>,<string>",
                  "description": "Filter by this exact set of status'"
                },
                {
                  "disabled": false,
                  "key": "debugState",
                  "value": "<string>,<string>",
                  "description": "Filter by this exact set of debug states.\n0 means not in debug\n1 means debug request sent to endpoint\n2 means debug request acknowledged by endpoint\n"
                },
                {
                  "disabled": false,
                  "key": "fallbackMode",
                  "value": "<string>",
                  "description": "Filter by the fallback mode"
                },
                {
                  "disabled": false,
                  "key": "locationId",
                  "value": "<string>",
                  "description": "Filter by this exact location id - with an underscore separating the case sensitive city and country values e.g. \"City_Country\""
                },
                {
                  "disabled": false,
                  "key": "agentVersion",
                  "value": "<string>",
                  "description": "Filter by this exact agent version"
                },
                {
                  "disabled": false,
                  "key": "first",
                  "value": "50",
                  "description": "An optional pagination param that states the number of records requested from the **start** of the `cursor`. The default value is **50**."
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<string>",
                  "description": "An optional pagination cursor. Pass the `endCursor` from the previous response's `pageInfo` to fetch the next page. Check `hasNextPage` in the previous response's `pageInfo` to determine whether more records are available."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "The direction of the sort by the `lastSeen` property. The default is to sort by descending"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
